{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "GetForAnonymous",
            "Effect": "Allow",
            "Principal": {
                "AWS": [
                    "*"
                ]
            },
            "Action": [
                "s3:GetObject"
            ],
            "Resource": [
                "arn:aws:s3:::kra/solution_files/*",
                "arn:aws:s3:::kra/work_materials/*"
            ],
            "Condition": {
                "IpAddress": {
                    "aws:SourceIp": [
                        "127.0.0.1/32"
                    ]
                }
            }
        }
    ]
}